{
  "id": "dev.schweiger.dashboard",
  "version": "1.4.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Web Dashboard"
  },
  "description": {
    "en": "Turn any screen in the house into a live control panel."
  },
  "category": [
    "tools"
  ],
  "tags": {
    "en": [
      "dashboard",
      "kiosk",
      "tablet",
      "wall panel",
      "browser",
      "web"
    ]
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "author": {
    "name": "Stefan Schweiger",
    "email": "st.schweiger@me.com"
  },
  "brandColor": "#2f6df0",
  "source": "https://github.com/stefan-schweiger/dev.schweiger.dashboard",
  "bugs": {
    "url": "https://github.com/stefan-schweiger/dev.schweiger.dashboard/issues"
  },
  "api": {
    "requestPairing": {
      "method": "POST",
      "path": "/pairing",
      "public": true
    },
    "getPairing": {
      "method": "GET",
      "path": "/pairing/:id",
      "public": true
    },
    "claimScreen": {
      "method": "PUT",
      "path": "/pairing/:id",
      "public": true
    },
    "listPairings": {
      "method": "GET",
      "path": "/pairings"
    },
    "approvePairing": {
      "method": "POST",
      "path": "/pairings/:id/approve"
    },
    "declinePairing": {
      "method": "POST",
      "path": "/pairings/:id/decline"
    },
    "getApiKeyStatus": {
      "method": "GET",
      "path": "/api-key"
    },
    "setApiKey": {
      "method": "PUT",
      "path": "/api-key"
    },
    "getHighlight": {
      "method": "GET",
      "path": "/highlight",
      "public": true
    },
    "closeHighlight": {
      "method": "POST",
      "path": "/highlight/close",
      "public": true
    },
    "listScreens": {
      "method": "GET",
      "path": "/screens"
    },
    "renameScreen": {
      "method": "PUT",
      "path": "/screens/:id"
    },
    "forgetScreen": {
      "method": "DELETE",
      "path": "/screens/:id"
    },
    "screenHello": {
      "method": "POST",
      "path": "/screen-hello",
      "public": true
    },
    "getWidgetModes": {
      "method": "GET",
      "path": "/widget-modes",
      "public": true
    },
    "setWidgetMode": {
      "method": "PUT",
      "path": "/widget-modes/:id",
      "public": true
    },
    "switchScreen": {
      "method": "POST",
      "path": "/screen-switch",
      "public": true
    },
    "renameOwnScreen": {
      "method": "POST",
      "path": "/screen-rename",
      "public": true
    }
  }
}
